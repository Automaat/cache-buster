<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mskalski.bilgie</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/bilgie</string>
		<string>tick</string>
	</array>
	<key>StartInterval</key>
	<integer>2700</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/me/Library/Logs/bilgie/auto.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/me/Library/Logs/bilgie/auto.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/Users/me/.local/share/mise/shims:/Users/me/go/bin:/Users/me/.cargo/bin:/Users/me/.docker/bin:/Applications/Docker.app/Contents/Resources/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
</dict>
</plist>
